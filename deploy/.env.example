FORMA_PUBLIC_URL=https://diagrams.example.com
FORMA_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
FORMA_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# At least one allowlist is required. Domain checks use Google's verified hd claim.
FORMA_ALLOWED_DOMAINS=example.com
FORMA_ALLOWED_EMAILS=
FORMA_USER_BYTES=100000000
FORMA_USER_FILES=1000
FORMA_MAX_USERS=500
