{
  "name": "forma-diagrams",
  "version": "0.3.0",
  "description": "Local-first professional diagrams for agents and humans",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "forma": "./packages/cli/bin.mjs"
  },
  "exports": {
    ".": "./packages/core/src/index.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/licenses.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "forma": "node --import tsx packages/cli/src/index.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "node --import tsx scripts/schema.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xyflow/react": "^12.10.0",
    "elkjs": "^0.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joeycast/forma.git"
  },
  "homepage": "https://github.com/joeycast/forma",
  "bugs": {
    "url": "https://github.com/joeycast/forma/issues"
  },
  "files": [
    "dist",
    "packages",
    "public/fonts",
    "skills",
    "docs",
    "examples",
    "schema",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
