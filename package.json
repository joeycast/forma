{
  "name": "forma-diagrams",
  "version": "0.5.0",
  "description": "Local-first professional diagrams for agents and humans",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diagrams",
    "diagramming",
    "cli",
    "agents"
  ],
  "bin": {
    "forma": "bin/forma"
  },
  "exports": {
    ".": "./packages/core/src/index.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/licenses.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "forma": "node --import tsx packages/cli/src/index.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "node --import tsx scripts/schema.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/blob": "^2.8.0",
    "@xyflow/react": "^12.10.0",
    "elkjs": "^0.11.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeycast/forma.git"
  },
  "homepage": "https://github.com/joeycast/forma",
  "bugs": {
    "url": "https://github.com/joeycast/forma/issues"
  },
  "files": [
    "bin",
    "dist",
    "packages",
    "public/fonts",
    "skills",
    "docs",
    "examples",
    "schema",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "Dockerfile",
    "deploy"
  ]
}
